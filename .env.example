VITE_PORTFOLIO_CHAT_API_URL=http://localhost:8787/api/chat

PORTFOLIO_CHAT_PROVIDER=gemini
PORTFOLIO_CHAT_PORT=8787
PORTFOLIO_CHAT_ALLOWED_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DISCORD_WEBHOOK_URL=

# Optional OpenAI fallback instead of Gemini:
# PORTFOLIO_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Cloudflare Worker deployment:
# 1. Set the Worker secret instead of using .env:
#    wrangler secret put GEMINI_API_KEY
#    wrangler secret put DISCORD_WEBHOOK_URL
# 2. Update wrangler.toml:
#    - ALLOWED_ORIGIN
#    - database_id
# 3. Point the frontend to:
#    VITE_PORTFOLIO_CHAT_API_URL=https://YOUR-WORKER.workers.dev/api/chat
